<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>playlister</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.skeeve.playlister</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Playlister</string>
	<key>CFBundleDisplayName</key>
	<string>Playlister</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<!-- no Dock icon or menu bar: the interface runs in the browser. A
	     foreground app without AppKit never signals the Dock that it has
	     finished launching, so its icon would bounce forever. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Stephan (Skeeve), MIT License</string>
	<!-- texts for the macOS privacy prompts (translated in *.lproj) -->
	<key>NSNetworkVolumesUsageDescription</key>
	<string>Playlister reads your music collection and saves playlists on network volumes.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>Playlister reads your music collection and saves playlists on external drives.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Playlister reads your music collection and saves playlists in your Documents folder.</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>Playlister reads your music collection and saves playlists on your Desktop.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Playlister reads your music collection and saves playlists in your Downloads folder.</string>
</dict>
</plist>
